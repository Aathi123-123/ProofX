# ============================================================
# PSDE Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_64_CHARS
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# PostgreSQL (primary)
DATABASE_URL=postgresql+asyncpg://psde_user:psde_password@localhost:5432/psde_db
# SQLite fallback (uncomment to use SQLite for local dev without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./psde.db

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Blockchain ---
# Hardhat local network
BLOCKCHAIN_NETWORK=hardhat-local
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=31337
# Contract address (populated after deployment)
COMMITMENT_CONTRACT_ADDRESS=
# Deployer private key (Hardhat test account - NEVER use real funds)
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Evidence Storage ---
EVIDENCE_STORAGE_PATH=./evidence_store
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=text/plain,text/csv,application/pdf,image/png,image/jpeg,image/gif,application/json,application/zip,application/octet-stream

# --- PII Detection ---
PII_DETECTOR=regex
# Options: regex | metadata | semantic (semantic requires optional external API)

# --- Benchmark ---
BENCHMARK_OUTPUT_PATH=./benchmarks/results
BENCHMARK_DEFAULT_SEED=42

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Admin Bootstrap (first-time setup only) ---
# These are used ONCE to create the first admin account.
# Remove or rotate after initial setup.
BOOTSTRAP_ADMIN_EMAIL=admin@psde.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
